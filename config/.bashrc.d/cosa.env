#export COREOS_ASSEMBLER_CONFIG_GIT="/development/os/fcos/fedora-coreos-config"
# rhcos
#export COREOS_ASSEMBLER_CONFIG_GIT="/development/os/cloud/k8s/okd/fcos/os"

cosa.okd()  {
  export COREOS_ASSEMBLER_CONFIG_GIT="/development/os/cloud/k8s/okd/fcos/okd-machine-os"
}

cosa.fcos()  {
  export COREOS_ASSEMBLER_CONFIG_GIT="/development/os/cloud/k8s/okd/fcos/fedora-coreos-config"
}

