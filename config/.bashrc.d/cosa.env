#!/bin/bash
export COSA_SKIP_OVERLAY=1
export COREOS_ASSEMBLER_GIT="/development/os/cloud/k8s/okd/fcos/coreos-assembler"
# okd
export COREOS_ASSEMBLER_CONFIG_GIT="/development/os/cloud/k8s/okd/fcos/okd-machine-os"
