#!/bin/bash
mvnteston() {
  export MAVEN_OPTS="-Xmx8G -DdownloadSources=true -Djava.awt.headless=true -Dfile.encoding=UTF-8"
}

mvntestoff() {
  export MAVEN_OPTS="-DdownloadSources=true -Djava.awt.headless=true -Dfile.encoding=UTF-8 -Dmaven.javadoc.skip=true -Dmaven.test.skip=true -DskipTests=true"
}
